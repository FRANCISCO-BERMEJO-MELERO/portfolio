---
// La página: navegación fija, las seis secciones en orden y los dos separadores sumi-e (C13).
import { ui } from '../i18n/ui.ts';
import Nav from './Nav.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Projects from './sections/Projects.astro';
import Journey from './sections/Journey.astro';
import Stack from './sections/Stack.astro';
import Contact from './sections/Contact.astro';
import InkDivider from './InkDivider.astro';
---

<a class="skip-link" href="#contenido">{ui.skipLink}</a>
<Nav />
<main id="contenido" tabindex="-1">
  <Hero />
  <About />
  <Projects />
  <InkDivider id="ink-divider-1" />
  <Journey />
  <Stack />
  <InkDivider id="ink-divider-2" />
  <Contact />
</main>

<style>
  /* Enlace para saltar la navegación: invisible hasta que recibe el foco. */
  .skip-link {
    position: absolute;
    z-index: 20;
    top: 8px;
    left: 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    background: var(--bg);
    color: var(--text);
    font-weight: 500;
    transform: translateY(calc(-100% - 16px));
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
