---
// Trazo de pincel de grosor variable (plan §1.9): línea central + grosor de cada tramo. Cada tramo
// es un segmento con extremos redondeados (como las maquetas) y el conjunto se revela a lo largo de
// la línea central con una máscara (stroke-dashoffset sobre pathLength = 1).
//
// El avance es --ink (0 → 1): sin JS o con reduced motion vale 1 (trazo entero). Más adelante, una
// escena de scroll podrá dar --ink: var(--p) (trayectoria, separadores). Con `draw`, se anima una
// vez al cargar; la animación mueve solo el stroke-dashoffset de la máscara (un elemento), no --ink,
// que al heredarse recalcularía el estilo de todo el SVG en cada fotograma.
interface Props {
  /** Id único en la página (lo usa la máscara). */
  id: string;
  viewBox: string;
  points: readonly (readonly [number, number])[];
  /** Grosor de cada tramo (uno menos que puntos). */
  widths: readonly number[];
  /** Nombre accesible; sin él, el trazo es decorativo (aria-hidden). */
  label?: string;
  /** Animación al cargar, en ms. */
  draw?: { duration: number; delay?: number };
  /** Estira el lienzo a la caja sin conservar la proporción (la trayectoria: solo en su eje largo). */
  stretch?: boolean;
  /** Guía fina en --line bajo el trazo: se ve lo que falta por pintar (d-09, m-08). */
  guide?: boolean;
}

const { id, viewBox, points, widths, label, draw, stretch = false, guide = false } = Astro.props;
const f = (v: number) => Math.round(v * 100) / 100;

// La máscara: la misma línea central, alargada por los dos extremos lo que mide el radio del trazo
// más grueso, para que al final cubra también los extremos redondeados.
const reveal = Math.max(...widths) + 4;
const ext = (a: readonly [number, number], b: readonly [number, number]): [number, number] => {
  const dx = a[0] - b[0];
  const dy = a[1] - b[1];
  const len = Math.hypot(dx, dy) || 1;
  return [f(a[0] + (dx / len) * (reveal / 2)), f(a[1] + (dy / len) * (reveal / 2))];
};
const first = ext(points[0]!, points[1]!);
const last = ext(points.at(-1)!, points.at(-2)!);
const centerline = `M${first.join(',')} ${points.map((p) => `L${p[0]},${p[1]}`).join(' ')} L${last.join(',')}`;
// La región de la máscara es el lienzo (por defecto se pasa un 10 % por cada lado).
const [vx, vy, vw, vh] = viewBox.split(/\s+/).map(Number);
const style = draw ? `--ink-duration: ${draw.duration}ms; --ink-delay: ${draw.delay ?? 0}ms` : undefined;
---

<svg
  class:list={['ink', { draw }]}
  viewBox={viewBox}
  preserveAspectRatio={stretch ? 'none' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={style}
>
  <mask id={id} maskUnits="userSpaceOnUse" x={vx} y={vy} width={vw} height={vh}>
    <path class="reveal" d={centerline} pathLength="1" stroke-width={reveal}></path>
  </mask>
  {guide && <polyline class="guide" points={points.map((p) => p.join(',')).join(' ')} />}
  <g class="strokes" mask={`url(#${id})`}>
    {widths.map((w, i) => <path d={`M${points[i]![0]},${points[i]![1]} L${points[i + 1]![0]},${points[i + 1]![1]}`} stroke-width={w} />)}
  </g>
</svg>

<style>
  /* Ocupa la caja que le dé quien lo contiene y toma su color. */
  .ink {
    width: 100%;
    height: 100%;
  }

  .guide {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .strokes {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }

  .reveal {
    fill: none;
    stroke: #fff;
    stroke-linecap: butt;
    stroke-linejoin: round;
    /* Un trazo de longitud 1 seguido de un hueco mayor: con --ink = 0 no se ve nada. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: calc(1 - var(--ink, 1));
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Capa propia mientras se dibuja: cada fotograma repinta solo el SVG, no la página (con el título
       de 152 px detrás, el repintado de la capa de la página daba fotogramas > 33 ms en móvil). */
    :global(html.js) .draw {
      will-change: transform;
    }

    :global(html.js) .draw .reveal {
      animation: ink-draw var(--ink-duration) cubic-bezier(0.45, 0.05, 0.3, 1) var(--ink-delay) both;
    }
  }

  @keyframes ink-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
