---
// Encabezado de sección: índice en kanji + título en versalitas (d-04, d-07, d-09, d-11; m-03…).
// En Inicio y Contacto las maquetas lo usan como antetítulo (<p>), con el titular grande aparte.
import type { SectionId } from '../i18n/ui.ts';
import { sections } from '../i18n/ui.ts';

interface Props {
  section: SectionId;
  as?: 'h2' | 'p';
}

const { section, as: Tag = 'h2' } = Astro.props;
const s = sections.find((x) => x.id === section)!;
---

<Tag class="heading" id={Tag === 'h2' ? `${s.id}-titulo` : undefined} data-qa="heading">
  <span class="index" aria-hidden="true" data-qa="heading-kanji">{s.index}</span>{s.title}
</Tag>

<style>
  .heading {
    display: flex;
    gap: 12px;
    align-items: baseline;
    /* Las maquetas no fijan interlineado: con el 1,5 de la web el encabezado mediría 1 px más. */
    line-height: normal;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .index {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--accent-text);
  }

  @media (min-width: 960px) {
    .heading {
      gap: 14px;
      font-size: 15px;
    }

    .index {
      font-size: 30px;
    }
  }
</style>
