---
// 二 Sobre mí (d-04…06, m-03…05): la escena kaizen con su columna de significado, el párrafo y los
// datos rápidos.
// - Escritorio: todo dentro del escenario sticky, como en las maquetas: encabezado y párrafo
//   arriba, kanji y significado, y los datos rápidos al pie.
// - Móvil: el escenario lleva el encabezado («Sobre mí · kaizen»), los kanji y el significado (m-03);
//   el párrafo y los datos rápidos, que las maquetas no muestran (C10), van después en flujo normal.
//   Por eso el párrafo y los datos están dos veces en el HTML: cada copia solo se muestra (y se lee)
//   en su diseño.
// - Escritorio con menos de 800 px de alto: los datos rápidos no caben en el escenario junto a la
//   columna de significado (a 1280 × 720 la pisarían) y salen de él, como en móvil (criterio 3).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import KaizenScene from '../kaizen/KaizenScene.astro';
import KaizenMeaning from '../kaizen/KaizenMeaning.astro';
import { site } from '../../data/site.ts';
import { ui } from '../../i18n/ui.ts';

const facts = ui.about.facts.map((label, i) => ({ label, value: site.facts[i]! }));
---

<Section id="sobre-mi" flush>
  <KaizenScene>
    <div class="head" slot="head" data-qa="about-head">
      <SectionHeading section="sobre-mi"><span class="suffix"> · {ui.about.headingSuffix}</span></SectionHeading>
      <p class="about desktop" data-pending={site.about.pending} data-qa="about-text">{site.about.text}</p>
    </div>
    <KaizenMeaning />
    <dl class="facts desktop" slot="foot" data-qa="about-facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="label">{f.label}</dt>
            <dd class="value" data-pending={f.value.pending} data-qa="about-fact">
              {f.value.text}
            </dd>
          </div>
        ))
      }
    </dl>
  </KaizenScene>
  <div class="after mobile" data-qa="about-after">
    <p class="about" data-pending={site.about.pending}>{site.about.text}</p>
    <dl class="facts">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="label">{f.label}</dt>
            <dd class="value" data-pending={f.value.pending}>
              {f.value.text}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  .after {
    padding: 8px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about {
    font-size: 18px;
    line-height: 1.6;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .fact {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .label {
    line-height: normal;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .value {
    margin-top: 6px;
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.3;
  }

  /* Después de .facts: la copia del escritorio no se ve (ni se lee) en móvil. */
  .desktop {
    display: none;
  }

  /* Escritorio (d-04…06): encabezado y párrafo en las mismas columnas que los kanji y el texto. */
  @media (min-width: 960px) {
    .mobile,
    .suffix {
      display: none;
    }

    .head {
      display: grid;
      grid-template-columns: var(--cols);
      gap: 24px 48px;
      align-items: baseline;
    }

    .desktop.about {
      display: block;
      font-size: 20px;
    }

    .desktop.facts {
      display: grid;
      margin-top: auto;
    }

    .facts {
      gap: 24px;
    }

    .fact {
      padding-top: 16px;
    }

    .label {
      font-size: 14px;
    }

    .value {
      margin-top: 8px;
      font-size: 28px;
      /* Como en la maqueta, sin interlineado propio. */
      line-height: normal;
    }
  }

  /* Escritorio bajo: los datos rápidos, después del escenario (la copia de móvil, sin su párrafo). */
  @media (min-width: 960px) and (max-height: 799px) {
    .desktop.facts,
    .after .about {
      display: none;
    }

    .after.mobile {
      display: block;
      padding: 0 0 48px;
    }
  }
</style>
