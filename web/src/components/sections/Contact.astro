---
// 六 Contacto (d-13, d-14, m-12, m-13): antetítulo, «¿Hablamos?» con el sello, enlaces, CV y pie.
// - El sello va a la derecha del titular en escritorio y debajo a la derecha en móvil, sin taparlo (C4).
//   Se estampa una sola vez, al entrar el titular en vista (scripts/reveal.ts). Sin JS o con reduced
//   motion, quieto desde el principio.
// - Entre 960 y 1440 px el titular y el sello escalan con el ancho (a 1440, las medidas de d-13).
// - Enlaces con área pulsable de 44 px (C14) sin cambiar la altura de las filas de las maquetas.
// - Lo pendiente de Fran (email, LinkedIn) enlaza a la propia sección mientras sea un marcador.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Hanko from '../Hanko.astro';
import Footer from '../Footer.astro';
import { site } from '../../data/site.ts';
import { ui } from '../../i18n/ui.ts';

const { email, github, linkedin, cv } = site.contact;
const here = '#contacto';
---

<Section id="contacto" flush>
  <div class="contact" data-qa="contact">
    <SectionHeading section="contacto" as="p" />
    <div class="head" data-reveal="0.6" data-qa="contact-head">
      <h2 id="contacto-titulo" class="title" data-qa="contact-title">{ui.contact.title}</h2>
      <span class="seal" data-qa="contact-seal"><Hanko variant="contact" data-qa="contact-hanko" /></span>
    </div>
    <div class="actions">
      <dl class="links" data-qa="contact-links">
        <div class="row">
          <dt data-qa="contact-label">{ui.contact.email}</dt>
          <dd data-qa="contact-value">
            <a class="hit" href={email.pending ? here : `mailto:${email.text}`} data-pending={email.pending} data-qa="contact-link"
              >{email.text}</a
            >
          </dd>
        </div>
        <div class="row">
          <dt data-qa="contact-label">{ui.contact.github}</dt>
          <dd data-qa="contact-value">
            <a class="hit" href={github.href} data-qa="contact-link"><span class="host">{github.host}</span>{github.user}</a>
          </dd>
        </div>
        <div class="row">
          <dt data-qa="contact-label">{ui.contact.linkedin}</dt>
          <dd data-qa="contact-value">
            <a class="hit" href={linkedin.pending ? here : linkedin.text} data-pending={linkedin.pending} data-qa="contact-link"
              >{linkedin.pending ? linkedin.text : linkedin.text.replace(/^https?:\/\/(www\.)?/, '')}</a
            >
          </dd>
        </div>
      </dl>
      <a class="cv" href={cv.text} download data-pending={cv.pending} data-qa="contact-cv"
        >{ui.contact.cv} <span aria-hidden="true">↓</span></a
      >
    </div>
    <Footer />
  </div>
</Section>

<script>
  import '../../scripts/reveal.ts';
</script>

<style>
  /* Móvil (m-12). Ocupa la pantalla bajo la nav y deja el pie abajo. */
  .contact {
    min-height: calc(100svh - var(--nav-h));
    padding: 28px 0 20px;
    display: flex;
    flex-direction: column;
  }

  .head {
    position: relative;
    margin-top: 24px;
    padding-bottom: 70px;
  }

  /* 58 px a 390 (m-12); por debajo, proporcional al ancho para caber a 360. */
  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(48px, 14.8718vw, 58px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .seal {
    position: absolute;
    right: 4px;
    top: 70px;
    display: flex;
  }

  .links {
    margin-top: 20px;
    border-top: 1px solid var(--text);
  }

  .row {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 13px;
    font-weight: 500;
    line-height: normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  dd {
    margin-top: 4px;
    font-size: 19px;
    line-height: normal;
    /* Sin espacios, el usuario de GitHub no se parte: que lo haga antes de desbordar. */
    overflow-wrap: anywhere;
  }

  dd a {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    text-underline-offset: 5px;
  }

  .host {
    display: none;
  }

  /* Área pulsable ≥ 44 × 44 sin cambiar la altura de las filas (C14, D5). */
  .hit {
    position: relative;
  }

  .hit::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100%, 46px);
    height: 46px;
    transform: translate(-50%, -50%);
  }

  /* Texto sobre --accent-solid (F9), como el botón principal del hero. */
  .cv {
    margin-top: 28px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--accent-solid);
    color: var(--on-accent);
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
  }

  .cv:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
  }

  /* Estampación al entrar en vista: como la caída del sello del hero (Nav.astro). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .head:not([data-revealed]) .seal {
      opacity: 0;
    }

    :global(html.js) .head[data-revealed] .seal {
      animation: contact-stamp 380ms cubic-bezier(0.3, 0, 0.2, 1) 120ms backwards;
    }
  }

  @keyframes contact-stamp {
    0% {
      opacity: 0;
      transform: scale(1.9) rotate(-12deg);
    }
    50% {
      opacity: 1;
    }
    70% {
      transform: scale(0.94) rotate(0.5deg);
    }
    100% {
      transform: none;
    }
  }

  /* Escritorio (d-13). */
  @media (min-width: 960px) {
    .contact {
      padding: 48px 0 32px;
    }

    .head {
      align-self: flex-start;
      margin-top: 28px;
      padding-bottom: 0;
    }

    /* 184 px a 1440 (d-13), proporcional al ancho por debajo. */
    .title {
      font-size: min(12.7778vw, 184px);
    }

    /* A la derecha del titular, a 40 px (d-13: right −176 con un sello de 136). */
    .seal {
      right: calc(-1 * (var(--hanko-contact-size) + min(2.7778vw, 40px)));
      top: min(3.75vw, 54px);
    }

    .actions {
      margin-top: 56px;
      display: flex;
      flex-wrap: wrap;
      gap: 40px 64px;
      align-items: flex-end;
    }

    .links {
      flex: 1 1 640px;
      margin-top: 0;
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
    }

    .row {
      display: contents;
    }

    dt {
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
      font-size: 15px;
    }

    dd {
      margin: 0;
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
      font-size: 24px;
    }

    dd a {
      min-height: 0;
      display: inline;
    }

    .host {
      display: inline;
    }

    .cv {
      flex: none;
      margin-top: 0;
      height: 64px;
      padding: 0 36px;
      display: inline-flex;
      gap: 12px;
      font-size: 20px;
    }
  }
</style>
